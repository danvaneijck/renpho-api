# Copy to .env and fill in. Never commit .env.
RENPHO_EMAIL=your@email.com
RENPHO_PASSWORD=your_plain_text_password

# Optional
# RENPHO_OUTPUT_DIR=renpho_data
# RENPHO_DEBUG=1
# Reuse the login across runs (fewer logins, fewer phone sign-outs):
# RENPHO_SESSION_FILE=~/.config/renpho/session.json
# Read a friend's data instead of your own (see README):
# RENPHO_FRIEND_ID=
